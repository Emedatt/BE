# Django Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# ENVIRONMENT SELECTION
# =============================================================================
# Valid values: development, staging, production (default: development)
DJANGO_ENVIRONMENT=development

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# CRITICAL: Generate a new secret key for production!
# Use: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your_secret_key

# Debug mode (True for development, False for staging/production)
DJANGO_DEBUG=True

# =============================================================================
# ALLOWED HOSTS & CORS
# =============================================================================
# Comma-separated list of allowed hosts (required for staging/production)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Allow all CORS origins (development only)
DJANGO_CORS_ALLOW_ALL_ORIGINS=True

# Specific CORS origins (comma-separated, for staging/production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# DATABASE CONFIGURATION (Optional - SQLite used by default in development)
# =============================================================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=emedatt_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require

# =============================================================================
# CACHE CONFIGURATION (Optional - in-memory cache used in development)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
EMAIL_HOST='smtp.gmail.com'
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com
DEFAULT_TO_EMAIL=

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
FRONTEND_URL=http://localhost:3000

# =============================================================================
# API INTEGRATIONS
# =============================================================================
POSTMAN_API_KEY=your_postman_api_key
POSTMAN_WORKSPACE_ID=your_postman_workspace_id
POSTMAN_COLLECTION_ID=your_postman_collection_id

# =============================================================================
# PRODUCTION ONLY SETTINGS
# =============================================================================
# Custom admin URL (optional, for security obscurity)
# ADMIN_URL=custom-admin-path/

# Rate limiting (optional)
# THROTTLE_RATE_ANON=100/hour
# THROTTLE_RATE_USER=1000/hour
